; Engine configuration file.

config_version=5

[application]

config/name="SCP: Site-19"
config/description="Single-player survival horror in the SCP Foundation universe. CC BY-SA 3.0."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Loc="*res://scripts/core/loc.gd"
Db="*res://scripts/core/db.gd"
Sfx="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
